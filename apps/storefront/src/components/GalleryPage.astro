---
import type { Language } from '../lib/i18n';
import { paths } from '../lib/i18n';
import { getGalleryItems } from '../lib/gallery';

interface Props { lang: Language }
const { lang } = Astro.props;

const copy = lang === 'es' ? {
  eyebrow: 'GALERÍA DE FOTOGRAFÍA & EVENTOS',
  title: 'Presencia en Ferias, Exposiciones & Arte Ancestral',
  intro: 'Explora nuestra participación en ferias artesanales, eventos culturales y muestras de joyas en mullos teñidas a mano en Saraguro, Loja, Ecuador.',
  filterAll: 'Todas las fotos',
  filterFairs: 'Ferias & Exposiciones',
  filterCraft: 'Joyas & Detalles',
  filterArtisans: 'Tradición viva',
} : {
  eyebrow: 'PHOTOGRAPHY & EVENTS GALLERY',
  title: 'Presence at Fairs, Exhibitions & Ancestral Art',
  intro: 'Explore our participation in artisan fairs, cultural heritage events, and handwoven bead jewelry showcases from Saraguro, Loja, Ecuador.',
  filterAll: 'All photos',
  filterFairs: 'Fairs & Exhibitions',
  filterCraft: 'Jewelry & Details',
  filterArtisans: 'Living Tradition',
};

const toggleText = lang === 'es' ? {
  more: 'Ver más',
  less: 'Ver menos',
} : {
  more: 'See more',
  less: 'See less',
};

const items = await getGalleryItems(lang);
---

<section class="relative isolate min-h-[24rem] sm:min-h-[28rem] flex items-center bg-charcoal-950 text-white py-12 overflow-hidden">
  <img
    src="/images/hero-artesana-saraguro.png"
    alt="Fondo Galería de Artesanías de Saraguro"
    width="1800"
    height="600"
    class="absolute inset-0 size-full object-cover object-right sm:object-center opacity-85"
  />
  <div class="absolute inset-0 z-0 bg-gradient-to-r from-charcoal-950/95 via-charcoal-950/80 to-charcoal-950/20"></div>

  <div class="page-shell relative z-10 max-w-3xl">
    <span class="inline-block px-3.5 py-1.5 rounded-full bg-gold-400/20 border border-gold-400/30 text-gold-300 text-xs font-extrabold uppercase tracking-widest mb-4">
      {copy.eyebrow}
    </span>
    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white leading-tight">
      {copy.title}
    </h1>
    <p class="mt-5 text-base sm:text-lg text-ivory-100/90 leading-relaxed max-w-2xl">
      {copy.intro}
    </p>
  </div>
</section>

<main class="page-shell section-space">
  <!-- Gallery Grid -->
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-6">
    {items.map((item) => (
      <article class="break-inside-avoid group flex flex-col mb-8">
        <div class="relative w-full overflow-hidden rounded-2xl bg-charcoal-900">
          <img
            src={item.image}
            alt={item.title}
            width="600"
            height="450"
            loading="lazy"
            class="w-full h-auto object-cover transition-transform duration-500 ease-out group-hover:scale-103"
          />
          <!-- Subtle Hover Overlay -->
          <div class="absolute inset-0 bg-charcoal-950/0 group-hover:bg-charcoal-950/10 transition-colors duration-300"></div>
          
          <div class="absolute top-3 left-3 z-10">
            <span class="inline-flex items-center gap-1 rounded-full bg-charcoal-950/80 px-2.5 py-0.5 text-[10px] font-bold text-white backdrop-blur-sm border border-white/10 shadow-sm">
              📅 {item.year}
            </span>
          </div>

          <div class="absolute bottom-3 right-3 z-10">
            <span class="inline-flex items-center gap-1 rounded-full bg-charcoal-950/80 px-2.5 py-0.5 text-[10px] font-bold text-white backdrop-blur-sm border border-white/10 shadow-sm">
              📍 {item.location.split('·')[0].trim()} {item.location.split(' ').pop()}
            </span>
          </div>
        </div>

        <div class="mt-3 px-1 flex flex-col">
          <h2 class="text-sm font-bold text-charcoal-950 leading-snug group-hover:text-wine-800 transition-colors">
            {item.title}
          </h2>
          <div class="mt-1.5 flex flex-col items-start">
            <p class="text-xs text-charcoal-700/85 leading-relaxed line-clamp-1 transition-all duration-300">
              {item.description}
            </p>
            {item.description.length > 40 && (
              <button
                class="mt-1 text-[11px] font-bold text-wine-700 hover:text-wine-900 focus:outline-none transition-colors"
                onclick={`const p = this.previousElementSibling; p.classList.toggle('line-clamp-1'); this.textContent = p.classList.contains('line-clamp-1') ? '${toggleText.more}' : '${toggleText.less}';`}
              >
                {toggleText.more}
              </button>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>


</main>
