---
import type { Product } from '../data/products';
import type { Language } from '../lib/i18n';
import { messages, paths } from '../lib/i18n';
import FavoriteButton from './FavoriteButton';
import RatingWidget from './RatingWidget';
import { getCountryCode } from '../lib/geo';

interface Props { product: Product; lang: Language; index?: number }
const { product, lang, index = 0 } = Astro.props;
const t = messages[lang];
const content = product.translations[lang];

let countryCode = Astro.url.searchParams.get('country') || Astro.cookies.get('sumak-country-v2')?.value;
if (countryCode !== 'EC' && countryCode !== 'US') {
  try {
    countryCode = getCountryCode(Astro.clientAddress, Astro.request.headers);
  } catch (e) {
    countryCode = 'US';
  }
}

const activePrice = countryCode === 'EC' ? product.priceEcuador : product.priceUSA;
---

<article data-product-id={product.id} data-rating={product.rating || 5.0} class="group relative overflow-hidden rounded-[var(--radius-card)] border border-charcoal-950/10 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lift motion-reduce:transform-none" style={`animation-delay:${index * 90}ms`}>
  <a class="block overflow-hidden bg-ivory-100" href={paths.product(lang, product.slug)} aria-label={`${t.viewPiece}: ${content.name}`}>
    <img
      class="aspect-square size-full object-cover transition duration-500 group-hover:scale-[1.035] motion-reduce:transform-none"
      src={product.image.url}
      width={product.image.width}
      height={product.image.height}
      alt={product.image.alt[lang]}
      loading={index > 0 ? 'lazy' : 'eager'}
      decoding="async"
    />
  </a>
  <div class="absolute right-3 top-3 flex items-center gap-1.5 z-10">
    {product.category.slug === 'collares' && product.virtualTryOn?.enabled && (
      <span class="px-2 py-1 rounded-md bg-wine-800/90 text-gold-300 text-[0.65rem] font-extrabold shadow-sm border border-gold-400/30 backdrop-blur-sm">
        ✨ Probador AR
      </span>
    )}
    <FavoriteButton client:idle productId={product.id} addLabel={t.favoriteAdd} removeLabel={t.favoriteRemove} />
  </div>
  <div class="p-5">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
      <p class="text-xs font-extrabold uppercase tracking-[0.12em] text-terracotta-500">{product.category.label[lang]}</p>
      <RatingWidget client:idle productId={product.id} initialRating={product.rating || 5.0} initialCount={product.reviewsCount ?? 0} size="sm" lang={lang} readOnly={true} />
    </div>
    <h3 class="mt-2 text-2xl leading-tight text-charcoal-950">
      <a class="hover:text-wine-700" href={paths.product(lang, product.slug)}>{content.name}</a>
    </h3>
    <p class="mt-3 min-h-12 text-sm leading-6 text-charcoal-800/80 line-clamp-2">{content.description}</p>
    <div class="mt-5 flex items-center justify-between gap-4 border-t border-charcoal-950/10 pt-4">
      <div class="mt-3 flex items-center justify-between">
        {activePrice && (
          <span class="font-display text-xl font-extrabold text-wine-900">${activePrice.toFixed(2)} USD</span>
        )}
        {!activePrice && (
          <span class="font-bold text-wine-900">{lang === 'es' ? 'Consultar disponibilidad' : 'Ask for availability'}</span>
        )}
      </div>
      <a class="text-sm font-extrabold text-wine-700 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-wine-900" href={paths.product(lang, product.slug)}>{t.viewPiece}</a>
    </div>
  </div>
</article>
