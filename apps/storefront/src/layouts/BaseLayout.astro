          <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <nav class="flex flex-col gap-4 text-sm font-semibold" aria-label="Móvil">
        {(() => {
          const currentPath = Astro.url.pathname;
          const isHome = currentPath === `/${lang}` || currentPath === `/${lang}/` || canonicalPath === paths.home(lang);
          const isShop = currentPath.includes('/tienda') || currentPath.includes('/shop') || currentPath.includes('/producto') || currentPath.includes('/product');
          const isStory = (currentPath.includes('/nuestra-historia') || currentPath.includes('/our-story'));
          const isGallery = (currentPath.includes('/galeria') || currentPath.includes('/gallery'));
          const isProcess = (currentPath.includes('/proceso-artesanal') || currentPath.includes('/craft-process'));
          const isContact = (currentPath.includes('/contacto') || currentPath.includes('/contact'));

          const linkBase = "block px-4 py-2.5 rounded-lg whitespace-nowrap transition-all duration-200 focus:outline-none";
          const activeStyle = "bg-wine-700 text-white font-extrabold shadow-sm";
          const inactiveStyle = "text-charcoal-900 hover:text-wine-800 hover:bg-wine-100/70";

          return (
            <>
              <a class:list={[linkBase, isHome ? activeStyle : inactiveStyle]} href={paths.home(lang)}>{t.navHome}</a>
              <a class:list={[linkBase, isShop ? activeStyle : inactiveStyle]} href={paths.shop(lang)}>{t.navCollection}</a>
              <a class:list={[linkBase, isGallery ? activeStyle : inactiveStyle]} href={paths.gallery(lang)}>{t.navGallery}</a>
