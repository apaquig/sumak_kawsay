---
import '../styles/global.css';
import type { Language } from '../lib/i18n';
import { messages, paths } from '../lib/i18n';
import { getPublishedProducts } from '../lib/catalog';
import { getCountryCode } from '../lib/geo';
import FavoritesDrawer from '../components/FavoritesDrawer';
import WhatsAppWidget from '../components/WhatsAppWidget';

interface Props {
  lang: Language;
  title: string;
  description: string;
  canonicalPath: string;
  alternateEs: string;
  alternateEn: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  canonicalPath,
  alternateEs,
  alternateEn,
  image = '/images/hero-future.webp',
  noindex = false,
  schema,
} = Astro.props;

const t = messages[lang];
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(canonicalPath, site);
const socialImage = new URL(image, site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sumak Kawsay',
  url: new URL(paths.home(lang), site).toString(),
  description: t.footerText,
};
const schemas = schema
  ? [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : [organizationSchema];

let countryCode = Astro.url.searchParams.get('country') || Astro.cookies.get('sumak-country-v2')?.value;
if (countryCode !== 'EC' && countryCode !== 'US') {
  try {
    countryCode = getCountryCode(Astro.clientAddress);
  } catch (e) {
    console.error('GeoIP error:', e);
    countryCode = 'US';
  }
}
if (countryCode === 'EC' || countryCode === 'US') {
  Astro.cookies.set('sumak-country-v2', countryCode, { path: '/', maxAge: 31536000 });
}

const allProducts = (await getPublishedProducts(lang)).map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.translations[lang].name,
  category: p.category.label[lang],
  imageUrl: p.image.url,
  price: countryCode === 'EC' ? p.priceEcuador : p.priceUSA,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#671f32" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(alternateEs, site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternateEn, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/es/', site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sumak Kawsay" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      (function() {
        const getCookie = (name) => {
          const value = `; ${document.cookie}`;
          const parts = value.split(`; ${name}=`);
          if (parts.length === 2) return parts.pop().split(';').shift();
        };
        
        const urlParams = new URLSearchParams(window.location.search);
        const countryParam = urlParams.get('country');
        if (countryParam === 'EC' || countryParam === 'US') {
          document.cookie = `sumak-country-v2=${countryParam}; path=/; max-age=31536000; SameSite=Lax`;
          return;
        }

        if (!getCookie('sumak-country-v2')) {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          const country = (tz === 'America/Guayaquil' || tz === 'Pacific/Galapagos') ? 'EC' : 'US';
          document.cookie = `sumak-country-v2=${country}; path=/; max-age=31536000; SameSite=Lax`;
          window.location.reload();
        }
      })();
    </script>
  </head>
  <body>
    <a class="fixed left-3 top-3 z-[100] -translate-y-24 rounded bg-charcoal-950 px-4 py-3 font-bold text-white focus:translate-y-0" href="#main-content">
      {t.skip}
    </a>
    <header class="sticky top-0 z-50 border-b border-charcoal-950/10 bg-ivory-50/94 backdrop-blur-md">
      <div class="page-shell flex min-h-16 items-center justify-between gap-4 py-2">
        <a class="group flex min-h-11 items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-700 focus-visible:ring-offset-2 rounded-lg p-1" href={paths.home(lang)} aria-label={`Sumak Kawsay - ${t.languageName}`}>
          <span class="grid size-9 place-items-center rounded-full border-2 border-wine-700" aria-hidden="true">
            <span class="size-3 rounded-full bg-terracotta-500 ring-4 ring-gold-400/50"></span>
          </span>
          <span>
            <strong class="block font-display text-xl leading-none text-charcoal-950">Sumak Kawsay</strong>
            <small class="mt-1 block text-[0.63rem] font-bold uppercase tracking-[0.16em] text-terracotta-500">Saraguro · Loja</small>
          </span>
        </a>

        {/* Desktop Nav Links */}
        <nav class="hidden lg:flex flex-nowrap items-center gap-1 sm:gap-1.5 xl:gap-2 text-xs xl:text-sm font-semibold whitespace-nowrap py-1" aria-label="Principal">
          {(() => {
            const currentPath = Astro.url.pathname;
            const isHome = currentPath === `/${lang}` || currentPath === `/${lang}/` || canonicalPath === paths.home(lang);
            const isShop = currentPath.includes('/tienda') || currentPath.includes('/shop') || currentPath.includes('/producto') || currentPath.includes('/product');
            const isStory = (currentPath.includes('/nuestra-historia') || currentPath.includes('/our-story'));
            const isGallery = (currentPath.includes('/galeria') || currentPath.includes('/gallery'));
            const isProcess = (currentPath.includes('/proceso-artesanal') || currentPath.includes('/craft-process'));
            const isContact = (currentPath.includes('/contacto') || currentPath.includes('/contact'));

            const linkBase = "relative px-2.5 sm:px-3 py-1.5 rounded-lg whitespace-nowrap transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-700 focus-visible:ring-offset-2 focus-visible:ring-offset-ivory-50";
            const activeStyle = "bg-wine-700 text-white font-extrabold shadow-sm hover:bg-wine-800";
            const inactiveStyle = "text-charcoal-900 hover:text-wine-800 hover:bg-wine-100/70";

            return (
              <>
                <a
                  class:list={[linkBase, isHome ? activeStyle : inactiveStyle]}
                  href={paths.home(lang)}
                  aria-current={isHome ? "page" : undefined}
                >
                  {t.navHome}
                  {isHome && <span class="sr-only"> (Página actual)</span>}
                </a>
                <a
                  class:list={[linkBase, isShop ? activeStyle : inactiveStyle]}
                  href={paths.shop(lang)}
                  aria-current={isShop ? "page" : undefined}
                >
                  {t.navCollection}
                  {isShop && <span class="sr-only"> (Página actual)</span>}
                </a>
                <a
                  class:list={[linkBase, isGallery ? activeStyle : inactiveStyle]}
                  href={paths.gallery(lang)}
                  aria-current={isGallery ? "page" : undefined}
                >
                  {t.navGallery}
                  {isGallery && <span class="sr-only"> (Página actual)</span>}
                </a>
                <a
                  class:list={[linkBase, isStory ? activeStyle : inactiveStyle]}
                  href={paths.story(lang)}
                  aria-current={isStory ? "page" : undefined}
                >
                  {t.navStory}
                  {isStory && <span class="sr-only"> (Página actual)</span>}
                </a>
                <a
                  class:list={[linkBase, isProcess ? activeStyle : inactiveStyle]}
                  href={paths.process(lang)}
                  aria-current={isProcess ? "page" : undefined}
                >
                  {t.navProcess}
                  {isProcess && <span class="sr-only"> (Página actual)</span>}
                </a>
                <a
                  class:list={[linkBase, isContact ? activeStyle : inactiveStyle]}
                  href={paths.contact(lang)}
                  aria-current={isContact ? "page" : undefined}
                >
                  {t.navContact}
                  {isContact && <span class="sr-only"> (Página actual)</span>}
                </a>
              </>
            );
          })()}
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <FavoritesDrawer client:load products={allProducts} lang={lang} />
          
          <div class="hidden lg:flex items-center gap-1 rounded border border-charcoal-950/15 bg-white p-1" aria-label="Language selector">
            <a
              class:list={['grid min-h-9 min-w-9 place-items-center rounded-sm text-xs font-extrabold focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-700 focus-visible:ring-offset-1', lang === 'es' ? 'bg-wine-700 text-white' : 'hover:bg-ivory-100']}
              href={alternateEs}
              lang="es"
              hreflang="es"
              data-language="es"
              aria-current={lang === 'es' ? 'page' : undefined}>ES</a
            >
            <a
              class:list={['grid min-h-9 min-w-9 place-items-center rounded-sm text-xs font-extrabold focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-700 focus-visible:ring-offset-1', lang === 'en' ? 'bg-wine-700 text-white' : 'hover:bg-ivory-100']}
              href={alternateEn}
              lang="en"
              hreflang="en"
              data-language="en"
              aria-current={lang === 'en' ? 'page' : undefined}>EN</a
            >
          </div>

          {/* Official Social Icons with Solid Official Brand Colors */}
          <div class="hidden lg:flex items-center gap-1.5 border-l border-charcoal-950/15 pl-2 sm:pl-3" aria-label="Redes sociales">
