              target="_blank"
              rel="noopener noreferrer"
              class="grid size-9 sm:size-9.5 place-items-center rounded-full bg-[#1877F2] text-white shadow-sm transition-all hover:scale-115 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1877F2] focus-visible:ring-offset-2"
