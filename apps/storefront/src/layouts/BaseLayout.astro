              <svg class="size-4.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a
              href="https://tiktok.com/@sumak_kawsay0"
              target="_blank"
              rel="noopener noreferrer"
              class="grid size-9 sm:size-9.5 place-items-center rounded-full bg-[#000000] text-white shadow-sm transition-all hover:scale-115 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2"
              title="TikTok — Sumak Kawsay"
              aria-label="TikTok"
            >
              <svg class="size-4.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.98-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.82.56-1.33 1.52-1.33 2.52 0 .91.43 1.78 1.14 2.32.74.57 1.7.77 2.6.58.97-.19 1.81-.88 2.22-1.78.34-.72.43-1.53.42-2.33.03-4.71.01-9.42.02-14.13z"/></svg>
            </a>
          </div>

          {/* Hamburger Menu Toggle Button */}
          <button
            id="mobile-menu-toggle"
            class="lg:hidden p-2 rounded-lg text-charcoal-900 hover:bg-wine-100/70 focus:outline-none focus:ring-2 focus:ring-wine-700"
            aria-expanded="false"
            aria-label={lang === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
          >
            <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Nav Menu Drawer -->
    <div
      id="mobile-nav-menu"
      class="fixed inset-y-0 right-0 z-[100] w-full max-w-xs bg-ivory-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col p-6 border-l border-charcoal-950/10"
    >
      <div class="flex items-center justify-between border-b border-charcoal-950/10 pb-4 mb-6">
        <span class="font-display text-lg font-bold text-wine-900">{lang === 'es' ? 'Menú' : 'Menu'}</span>
        <button
          id="mobile-menu-close"
          class="p-2 rounded-full text-charcoal-800/60 hover:bg-charcoal-950/5 hover:text-charcoal-950 focus:outline-none"
          aria-label={lang === 'es' ? 'Cerrar' : 'Close'}
