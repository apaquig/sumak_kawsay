              <a class:list={[linkBase, isContact ? activeStyle : inactiveStyle]} href={paths.contact(lang)}>{t.navContact}</a>
            </>
          );
        })()}
      </nav>
      
      <div class="mt-auto border-t border-charcoal-950/10 pt-6 space-y-6">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-charcoal-800/50">{lang === 'es' ? 'Idioma' : 'Language'}</span>
          <div class="flex items-center gap-1 rounded border border-charcoal-950/15 bg-white p-1">
            <a class:list={['grid min-h-9 min-w-9 place-items-center rounded-sm text-xs font-extrabold focus:outline-none', lang === 'es' ? 'bg-wine-700 text-white' : 'hover:bg-ivory-100']} href={alternateEs} lang="es" hreflang="es" data-language="es">ES</a>
            <a class:list={['grid min-h-9 min-w-9 place-items-center rounded-sm text-xs font-extrabold focus:outline-none', lang === 'en' ? 'bg-wine-700 text-white' : 'hover:bg-ivory-100']} href={alternateEn} lang="en" hreflang="en" data-language="en">EN</a>
          </div>
        </div>
        
        <div class="flex items-center justify-center gap-3 pt-2">
